@model Label_Exo.Models.Artiste

@{
    ViewData["Title"] = "Create";
}

<h1>Ajouter un groupe</h1>

<h4>Album</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NomScenique" class="control-label"></label>
                <input asp-for="NomScenique" class="form-control" />
                <span asp-validation-for="NomScenique" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StyleMusical" class="control-label"></label>
                <input asp-for="StyleMusical" class="form-control" />
                <span asp-validation-for="StyleMusical" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateSignature" class="control-label"></label>
                <input asp-for="DateSignature" class="form-control" />
                <span asp-validation-for="DateSignature" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LabelId" class="control-label"></label>
                <input asp-for="LabelId" class="form-control" />
                <span asp-validation-for="LabelId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Label" class="control-label"></label>
                <input asp-for="Label" class="form-control" />
                <span asp-validation-for="Label" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Retour à la liste</a>
</div>
@model Label_Exo.Models.Artiste

@{
    ViewData["Title"] = "Ajouter un label";
}

<h1>Ajouter un artiste</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="NomScenique" class="form-label"></label>
        <input asp-for="NomScenique" class="form-control" />
        <span asp-validation-for="NomScenique" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StyleMusical" class="form-label"></label>
        <input asp-for="StyleMusical" class="form-control" />
    </div>

    <div class="form-group">
        <label class="control-label">Année de signature</label>
        <input type="number" name="anneeSignature" class="form-control" min="1900" max="2100" />
    </div>

    <div class="mb-3">
        <select asp-for="LabelId" asp-items="ViewBag.Labels" class="form-control">
            <option value="">-- Choisir un label --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Créer</button>

    <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>

</form>
@{
    ViewData["Title"] = "Albums";
}

<h2 class="mb-4">Liste des albums</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Album Id</th>
            <th>Nom</th>
            <th>Artiste Id</th>
            <th>Année de sortie</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Album album in Model)
        {
            <tr>
                <td>@album.Id</td>
                <td>@album.Titre</td>
                <td>@album.DateSortie</td>
                <td>@album.ArtisteId</td>
                <td>@album.Artiste</td>
            </tr>
        }
    </tbody>
</table>
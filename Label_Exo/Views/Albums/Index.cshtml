@{
    ViewData["Title"] = "Albums";
}

<h2 class="mb-4">Liste des albums</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Album Id</th>
            <th>Nom</th>
            <th>Artiste Id</th>
            <th>Année de sortie</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Albums album in Model)
        {
            <tr>
                <td>@album.Id</td>
                <td><a asp-controller="Albums" asp-action="ByArtist" asp-route-albumId="@album.Id">@album.Name</a></td>
                <td>@album.ArtistId</td>
                <td>@album.Year</td>
            </tr>
        }
    </tbody>
</table>
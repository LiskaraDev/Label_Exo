@{
    ViewData["Title"] = "Liste des Users";
}

<h2 class="mb-4">Liste des utilisateurs</h2>"

<table class="table table-striped table-hover align-middle">
    <thead class="= "table-dark">
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>
        @foreach(User user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
            </tr>
        }
    </tbody>
</table>

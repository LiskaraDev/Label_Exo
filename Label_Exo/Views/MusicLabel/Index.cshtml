@model IEnumerable<Label_Exo.Models.MusicLabel>

@{
    ViewData["Title"] = "Labels musicaux";
}

<h1>Labels musicaux</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un label</a>
    <a asp-action="Edit" class="btn btn-primary">Modifier un label</a>
    <a asp-action="Delete" class="btn btn-primary">Supprimer un label</a>
</p>

@if (!Model.Any())
{
    <p>Aucun label enregistré.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Genre principal</th>
                <th>Année de création</th>
                <th>Adresse</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var label in Model)
            {
                <tr>
                    <td>@label.Nom</td>
                    <td>@label.GenrePrincipal</td>
                    <td>@label.AnneeCreation</td>
                    <td>@label.Adresse</td>
                </tr>
            }
        </tbody>
    </table>
}

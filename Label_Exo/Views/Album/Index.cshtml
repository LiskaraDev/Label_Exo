@model IEnumerable<Label_Exo.Models.Album>

@{
    ViewData["Title"] = "Albums";
}

<h2 class="mb-4">Liste des albums</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un album</a>
    <a asp-action="Edit" class="btn btn-primary">Modifier un album</a>
    <a asp-action="Delete" class="btn btn-primary">Supprimer un album</a>
</p>

@if (!Model.Any())
{
    <p>Aucun album n'est enregistré.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Date de sortie</th>
                <th>Prix</th>
                <th>Artiste</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var album in Model)
            {
                <tr>
                    <td>@album.Id</td>
                    <td>@album.Titre</td>
                    <td>@album.DateSortie</td>
                    <td>@album.PrixVente</td>
                    <td>@album.Artiste?.NomScenique</td>
                </tr>
            }
        </tbody>
    </table>
}
@{
    ViewData["Title"] = "Artists";
}

<h2 class="mb-4">Liste des artistes</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Style</th>
            <th>Début en:</th>
            <th>Langue</th>
            <th>Est Actif</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Artiste artist in Model)
        {
            <tr>
                <td>@artist.Id</td>
                <td>@artist.NomScenique</td>
                <td>@artist.StyleMusical</td>
                <td>@artist.DateSignature</td>
                <td>@artist.LabelId</td>
                <td>@artist.Label</td>
            </tr>
        }
    </tbody>
</table>

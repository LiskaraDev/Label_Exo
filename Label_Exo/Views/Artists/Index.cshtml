@{
    ViewData["Title"] = "Artists";
}

<h2 class="mb-4">Liste des artistes</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Style</th>
            <th>Début en:</th>
            <th>Langue</th>
            <th>Est Actif</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Artists artist in Model)
        {
            <tr>
                <td>@artist.Id</td>
                <td><a asp-controller="Albums" asp-action="ByArtist" asp-route-artistId="@artist.Id">@artist.Name</a></td>
                <td>@artist.Style</td>
                <td>@artist.Started</td>
                <td>@artist.Language</td>
                <td>@artist.IsActive</td>
            </tr>
        }
    </tbody>
</table>